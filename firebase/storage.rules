rules_version = '2';
// StepBuddy Storage Security Rules.
// Screenshots live under screenshots/{guideId}/{stepId}.jpg. The caregiver
// (any signed-in user, in this simple model) can upload; linked elderly devices
// download via the public download URL synced through Firestore.
//
// NOTE: for tighter control you can mirror the Firestore `links` check here by
// storing guide ownership metadata; this baseline keeps setup simple while
// still requiring authentication for writes.
service firebase.storage {
  match /b/{bucket}/o {
    match /screenshots/{guideId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024          // 5 MB cap
        && request.resource.contentType.matches('image/.*'); // images only
    }
  }
}
