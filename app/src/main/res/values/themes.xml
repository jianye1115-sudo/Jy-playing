<?xml version="1.0" encoding="utf-8"?>
<!--
  Base window theme. Actual UI colors/typography come from the Compose theme
  (ui/theme/Theme.kt). We deliberately parent off the platform Material theme
  so no extra com.google.android.material dependency is needed.
-->
<resources>
    <style name="Theme.StepBuddy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/teal_700</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
